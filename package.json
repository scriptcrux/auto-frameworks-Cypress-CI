{
  "name": "cypress-enterprise-test-framework",
  "version": "1.0.0",
  "description": "Scalable Cypress & TypeScript test automation framework engineered with Page Object Model (POM), cross-browser CI/CD matrix execution, Dockerized pipelines, Jenkins automation, data-driven testing (JSON/CSV), and Mochawesome HTML reporting.",
  "main": "index.js",
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:edge": "cypress run --browser edge",
    "test:firefox": "cypress run --browser firefox",
    "test:electron": "cypress run --browser electron",
    "test:headed": "cypress run --headed",
    "clean:reports": "rimraf cypress/reports cypress/screenshots cypress/videos",
    "combine-reports": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/mochareports/report.json",
    "generate-report": "marge cypress/reports/mochareports/report.json -f report -o cypress/reports/mochareports",
    "lint": "eslint cypress/**/*.ts",
    "lint:fix": "eslint cypress/**/*.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cypress",
    "typescript",
    "test-automation",
    "e2e-testing",
    "page-object-model",
    "pom",
    "ci-cd",
    "github-actions",
    "jenkins",
    "docker",
    "cross-browser",
    "mochawesome",
    "sdet",
    "qa-engineering"
  ],
  "author": "Aman Patwal (Scriptcrux)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/APdrone/auto-frameworks-CI.git"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "cypress": "^13.6.4",
    "cypress-mochawesome-reporter": "^3.8.2",
    "cypress-multi-reporters": "^1.6.4",
    "eslint": "^9.39.4",
    "eslint-plugin-chai-friendly": "^0.7.4",
    "eslint-plugin-cypress": "^2.15.1",
    "fast-csv": "^5.0.1",
    "marge": "^1.0.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "neat-csv": "^5.2.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.3.3"
  }
}
